{
  "name": "vistta-erp",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc && vite build",
    "validate": "npm run typecheck && npm run build && npm run validate:sourcemaps",
    "validate:sourcemaps": "find dist -type f -name '*.map' -print -quit | grep -q .",
    "build:functions": "npm run build --prefix functions",
    "build:all": "npm run build:functions && npm run build",
    "upload:sourcemaps": "npx @sentry/cli sourcemaps upload ./dist --org vistta-erp --project vistta-erp --release $npm_package_name@$npm_package_version",
    "deploy:hosting": "npm run build && npm run upload:sourcemaps && npx firebase-tools deploy --only hosting",
    "preview": "vite preview"
  },
  "dependencies": {
    "@sentry/react": "^10.73.0",
    "firebase": "^10.14.1",
    "lucide-react": "^0.364.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "postcss": "^8.4.38",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
